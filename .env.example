PORT=4173
# 0.0.0.0 allows devices on the same local network to connect.
HOST=0.0.0.0
# Use your computer's LAN address here when testing checkout from a phone.
BASE_URL=http://localhost:4173
# Render production stores SQLite under its persistent disk mount.
# DATA_DIR=/var/data

# Optional: enables hosted Stripe Checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: enables merchant email notifications through Resend.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_FROM_EMAIL=Luminara <orders@example.com>
PUBLIC_ORIGINS=https://qiuyilingimd.github.io
